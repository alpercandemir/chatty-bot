    {"id": "CS-FAQ-AREAS", "workspaceId": "demo-clearspace", "version": 1, "title": "Demo cleaning service areas", "content": "ClearSpace Cleaning serves offices and private properties in Kadikoy, Atasehir, and Umraniye. Other areas require human review; the assistant must not promise service availability there."},
