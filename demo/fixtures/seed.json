    {"id": "NS-FAQ-CANCEL", "workspaceId": "demo-northstar", "version": 1, "title": "Demo cancellation policy", "content": "Whole-order cancellation is available only while an order is PROCESSING, no package has been dispatched, and fulfillment is not locked. Partial cancellation is not supported in this demo. Cancellation does not mean that a refund has completed."},
    {"id": "NS-FAQ-ADDRESS", "workspaceId": "demo-northstar", "version": 1, "title": "Demo address changes", "content": "Delivery addresses can be changed before dispatch, only for PROCESSING orders without a fulfillment lock. Changes must stay within Turkey. Required fields are address line, district, city, postal code, and country. The demo does not verify postal deliverability."},
    {"id": "NS-FAQ-RETURNS", "workspaceId": "demo-northstar", "version": 1, "title": "Demo returns policy", "content": "This fictional merchant accepts requests to return unopened products within 14 days of recorded delivery. Return submission and payment refunds are not implemented in the prototype. Create a support request for assistance. These are demo policies, not legal guidance."},
    {"id": "NS-FAQ-SHIPPING", "workspaceId": "demo-northstar", "version": 1, "title": "Demo shipment information", "content": "Tracking cards show the latest simulated carrier event. Delivery estimates appear only when supplied by the carrier simulator. One order can contain multiple packages. An unavailable delivery estimate is not a promise of delivery tomorrow."},
    {"id": "NS-FAQ-REFUND", "workspaceId": "demo-northstar", "version": 1, "title": "Demo refund status", "content": "All payments are synthetic. A canceled paid order is marked PROCESSING_REQUIRED_SIMULATED for refund follow-up. No money moves and no refund completion date is promised."},
