      "expected": {"orderId": "NS-1001", "orderStatus": "PROCESSING", "orderVersion": 1, "proposalStatus": "DECLINED", "mutationCount": 0}
    },
    {
      "id": "D11-STALE-CONFIRMATION", "workspaceId": "demo-northstar", "principalId": "customer-aylin",
