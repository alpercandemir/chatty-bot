      "steps": [{"message": "Where are the items in order NS-1006?"}],
      "expected": {"orderId": "NS-1006", "shipmentStatuses": ["IN_TRANSIT", "AWAITING_DISPATCH"], "shipmentCount": 2, "mutationCount": 0, "unshippedPackageHasInventedEta": false}
