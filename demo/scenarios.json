      "expected": {"source": "CS-FAQ-AREAS", "callbackRequestCount": 1, "callbackStatus": "REQUESTED", "interest": "CLEANING_SERVICE", "calendarBookingCount": 0, "externalMessagesSent": 0}
    },
    {
      "id": "D14-CLEANING-CRM", "workspaceId": "demo-clearspace", "principalId": "prospect-crm",
      "steps": [{"message": "I run a cleaning company with 12 employees. I need help scheduling jobs and assigning employees. Can I request a CRM demo callback by email at crm@example.invalid next weekday morning?"}, {"uiAction": "CONFIRM_CURRENT_PROPOSAL"}],
      "expected": {"callbackRequestCount": 1, "callbackStatus": "REQUESTED", "interest": "CLEANING_CRM", "calendarBookingCount": 0, "inventedSubscriptionPrice": false}
