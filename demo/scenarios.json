      "expected": {"orderId": "NS-1001", "orderStatus": "CANCELLED", "operationStatusesInOrder": ["UNKNOWN", "SUCCEEDED"], "mutationCount": 1, "successClaimBeforeReconciliation": false}
    },
    {
