    {
      "id": "D15-COUNTRY-DENIAL", "workspaceId": "demo-northstar", "principalId": "customer-aylin",
      "steps": [{"message": "Send order NS-1001 to Demo Avenue 5, Demo District, Berlin, 10115, Germany."}],
      "expected": {"orderId": "NS-1001", "policyCode": "COUNTRY_CHANGE_NOT_SUPPORTED", "mutationCount": 0, "confirmationOffered": false}
    },
    {
      "id": "D16-READ-TIMEOUT", "workspaceId": "demo-northstar", "principalId": "customer-aylin",
      "steps": [{"presenterAction": "ARM_FAULT", "fault": "READ_TIMEOUT", "orderId": "NS-1002", "occurrences": 2}, {"message": "Where is order NS-1002?"}],
      "expected": {"mutationCount": 0, "transientReadRetryCount": 1, "trackingUnavailableAcknowledged": true, "inventedTrackingFacts": false}
