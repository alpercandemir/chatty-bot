{
  "scenarioVersion": "1.0.0",
  "fixture": "fixtures/seed.json",
  "description": "Proposed demo journeys and expected business outcomes. Each journey begins with an isolated fixture reset; live AI wording may vary.",
  "scenarios": [
    {
      "id": "D01-TRACKING", "workspaceId": "demo-northstar", "principalId": "customer-aylin",
      "steps": [{"message": "Where is order NS-1002?"}],
      "expected": {"orderId": "NS-1002", "shipmentStatus": "IN_TRANSIT", "etaAvailable": true, "mutationCount": 0, "requiredFacts": ["Demo Parcel", "DEMO-TRACK-1002", "Latest event and estimated delivery from simulator"]}
    },
    {
      "id": "D02-CANCEL-SUCCESS", "workspaceId": "demo-northstar", "principalId": "customer-aylin",
      "steps": [{"message": "Cancel order NS-1001."}, {"uiAction": "CONFIRM_CURRENT_PROPOSAL"}, {"uiAction": "CONFIRM_SAME_PROPOSAL_AGAIN"}],
      "expected": {"orderId": "NS-1001", "orderStatus": "CANCELLED", "orderVersion": 2, "operationStatus": "SUCCEEDED", "mutationCount": 1, "refundStatus": "PROCESSING_REQUIRED_SIMULATED"}
