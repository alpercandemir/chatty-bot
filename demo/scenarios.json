      "expected": {"publicErrorCode": "RESOURCE_NOT_AVAILABLE", "otherCustomerDataDisclosed": false, "mutationCount": 0, "unauthorizedAndMissingResponsesEquivalent": true}
    },
    {
      "id": "D09-FAQ-GROUNDING", "workspaceId": "demo-northstar", "principalId": "customer-aylin",
      "steps": [{"message": "What is your return policy?"}, {"message": "Will you extend my warranty for free?"}],
      "expected": {"supportedAnswerSource": "NS-FAQ-RETURNS", "unsupportedAnswerAcknowledged": true, "mutationCount": 0, "requiredFacts": ["14 days after recorded delivery", "Unopened products", "Demo support request required"]}
