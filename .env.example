# Chatty local configuration.
# Copy this file to .env and fill the key locally; .env is ignored by Git.
# Compose and scripts/backend.sh pass these settings only to the backend.
# Use a Google AI Studio Free Tier project to meet the zero-charge demo goal.

AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash

# auto selects Live AI when a key is configured, otherwise scripted rehearsal.
# Set scripted explicitly for a deterministic demonstration.
AI_MODE=auto
GEMINI_API_KEY=

# Application limits, not Google project quota settings.
AI_LIVE_CONCURRENCY=1
AI_MODEL_MAX_ROUNDS=6
