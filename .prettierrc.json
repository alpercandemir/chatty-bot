{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 100,
    "singleQuote": true,
    "plugins": ["prettier-plugin-java", "prettier-plugin-sh", "@prettier/plugin-xml"],
    "overrides": [
        {
            "files": "*.java",
            "options": {
                "singleQuote": false
            }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "*.xml",
            "options": {
                "xmlWhitespaceSensitivity": "ignore"
            }
        }
    ]
}
